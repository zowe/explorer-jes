{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "react"
  },
  "include": [
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist-test"
  ]
}
