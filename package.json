{
  "name": "explorer-jes",
  "version": "3.0.6",
  "types": "module",
  "dependencies": {
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "4.11.3",
    "file-saver": "2.0.5",
    "immutable": "3.8.2",
    "jszip": "3.10.1",
    "orion-editor-component": "0.0.16",
    "prop-types": "15.8.1",
    "react": "16.14.0",
    "react-contextmenu": "2.14.0",
    "react-dom": "16.14.0",
    "react-redux": "5.1.2",
    "react-router": "5.2.0",
    "react-router-dom": "5.2.0",
    "redux": "4.1.0",
    "redux-immutable": "4.0.0",
    "redux-thunk": "2.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.25.1",
    "@babel/preset-react": "7.24.7",
    "@types/chai": "4.3.18",
    "@types/mocha": "10.0.7",
    "@types/node": "13.13.52",
    "@types/react": "16.9.56",
    "@types/selenium-webdriver": "4.0.13",
    "babel-loader": "9.1.3",
    "c8": "11.0.0",
    "chai": "4.5.0",
    "compression-webpack-plugin": "11.1.0",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.2",
    "eslint": "8.56.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-react": "7.35.0",
    "expect": "29.7.0",
    "explorer-fvt-utilities": "2.0.4",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.7",
    "mocha": "10.7.3",
    "mocha-jenkins-reporter": "0.4.8",
    "nock": "14.0.15",
    "redux-mock-store": "1.5.4",
    "rewire": "7.0.0",
    "selenium-webdriver": "4.0.0-beta.3",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.3.10",
    "typescript": "5.7.3",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.4"
  },
  "scripts": {
    "dev": "webpack serve --config ./webpack.config.js --mode development --hot",
    "start": "OUTPUT_FOLDER='web' webpack --progress --color --watch --mode development",
    "lint": "eslint ./WebContent/js/",
    "test": "tsc -p tsconfig.test.json && JUNIT_REPORT_PATH=target/report.xml c8 mocha --timeout 999999 dist-test/tests/UnitTests --recursive --color --reporter mocha-jenkins-reporter",
    "testWatch": "tsc -p tsconfig.test.json --watch & mocha --watch dist-test/tests/UnitTests --recursive",
    "test:fvt": "tsc -p tsconfig.test.json && JUNIT_REPORT_PATH=target/report-fvt.xml mocha --timeout 999999 dist-test/tests/FVTTests --recursive --color --reporter mocha-jenkins-reporter",
    "prod": "webpack --mode production",
    "preCommit": "npm run lint && npm run test && npm run prod"
  },
  "repository": "zowe/explorer-jes",
  "browserslist": [
    "last 2 years"
  ],
  "description": "JES Explorer",
  "author": "IBM",
  "license": "EPL-2.0",
  "c8": {
    "reporter": [
      "lcov",
      "cobertura",
      "text"
    ],
    "report-dir": "./coverage",
    "all": true,
    "include": [
      "dist-test/WebContent/js/actions/**",
      "dist-test/WebContent/js/reducers/**"
    ],
    "exclude": [
      "dist-test/tests",
      "WebContent/js/themes",
      "WebContent/js/resources/languages"
    ]
  }
}
