    "clean-webpack-plugin": "4.0.0",
    "compression-webpack-plugin": "11.1.0",
    "copy-webpack-plugin": "12.0.2",
    "core-js": "3.38.1",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
